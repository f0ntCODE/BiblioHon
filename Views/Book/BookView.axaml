<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BiblioHon.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800"
        x:Class="BiblioHon.Views.BookView"
        x:DataType="vm:BookViewModel"
        Title="Register new book">

    <Design.DataContext>
        <vm:BookViewModelExample/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

            <StackPanel Margin="20"
                        Spacing="10"
                        HorizontalAlignment="Center"
                        Grid.Column="0">

                    
                <TextBlock Text= "Register book"
                           FontSize="24"
                           FontWeight="Bold"
                           Grid.Column="0"/>

                <TextBlock Text="type book's name" />
                <TextBox Text="{Binding BookName}" />

                <TextBlock Text="Type book's author"/>
                <TextBox Text="{Binding Author}" />
                
                <TextBlock Text="Type book's publisher"/>
                <TextBox Text="{Binding Publisher}" />
                
                <TextBlock Text="Type book's ISBN"/>
                <TextBox Text="{Binding Isbn}" />
                
                <TextBlock Text="Type book's publication year"/>
                <TextBox Text="{Binding PublicationYear}" />
                
                <TextBlock Text="Type book's genre"/>
                <TextBox Text="{Binding Genre}" />

                <Button Content="Register"
                        Command="{Binding RegisterBookCommand}"/>
            </StackPanel>

            <TableView Grid.Column="1" ItemsSource="{Binding Books}" Margin="10">
                <TableView.Columns>
                    <TableViewColumn Header="Book name" 
                    Binding="{Binding BookName}" />
                    
                    <TableViewColumn Header="Author" 
                    Binding="{Binding Author}" />

                    <TableViewColumn Header="Action" Width="90">
                        <TableViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="false"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />   
                            </DataTemplate>
                        </TableViewColumn.CellTemplate>
                    </TableViewColumn>

                </TableView.Columns>

            </TableView>

            
        
    </Grid>
</Window>
