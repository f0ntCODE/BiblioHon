<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BiblioHon.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="BiblioHon.Views.BookView"
        x:DataType="vm:BookViewModel"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Title="BiblioHon Book Manager Window">

    <Design.DataContext>
        <vm:BookViewModelExample/>
    </Design.DataContext>

    <Grid ShowGridLines="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="20"
                    Spacing="10"
                    HorizontalAlignment="Center"
                    Grid.Column="0">

                <Button Content="Add new"
                        />

                <Button Content="Edit"
                        />
            
        </StackPanel>

        <TableView Grid.Column="1"
                   ItemsSource="{Binding Books}"
                   Margin="10">
            <TableView.Columns>
                <TableViewColumn Header="ID"
                                 Binding="{Binding Id}"
                                 Width="*"
                                 HorizontalContentAlignment="Center"
                                 />

                <TableViewColumn Header="Book Name"
                                 Binding="{Binding BookName}"
                                 Width="*"
                                 HorizontalContentAlignment="Center" />

                <TableViewColumn Header="Author"
                                 Binding="{Binding Author}"
                                 Width="*"
                                 HorizontalContentAlignment="Center" />

                <TableViewColumn Header="Publisher"
                                 Binding="{Binding BookName}"
                                 Width="*"
                                 HorizontalContentAlignment="Center" />
                <TableViewColumn Header="Book Name"
                                 Binding="{Binding BookName}"
                                 Width="*"
                                 HorizontalContentAlignment="Center" />
                <TableViewColumn Header="Book Name"
                                 Binding="{Binding BookName}"
                                 Width="*"
                                 HorizontalContentAlignment="Center" />



                <TableViewColumn Header="Action"
                                 Width="*"
                                 HorizontalContentAlignment="Center">
                    <TableViewColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Margin="10">
                                <Button
                                    Content="Exclude"
                                    Command="{Binding $parent[Window].DataContext.DeleteBookCommand}"
                                    CommandParameter="{Binding}" />

                                <Button Content="Edit"
                                        Click="Edit_Click" />
                            </StackPanel>
                        </DataTemplate>
                    </TableViewColumn.CellTemplate>
                </TableViewColumn>
            </TableView.Columns>
        </TableView>
    </Grid>
</Window>
