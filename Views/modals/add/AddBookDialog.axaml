<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:BiblioHon.ViewModels"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="570"
        x:Class="BiblioHon.Views.modals.add.AddBookView"
        x:DataType="vm:BookViewModel"
        Title="Register new Book"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        >
  
        <Grid ShowGridLines="True"
        ColumnDefinitions="*">

    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="5*"/>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0"
                VerticalAlignment="Center">

      <TextBlock
        Text="Add Book"
        TextAlignment="Center"
        />
    </StackPanel>

    

    <StackPanel Grid.Row="1"
                Orientation="Vertical"
                VerticalAlignment="Top"
                Margin="10">

      <Label Content="Book Name"
             Margin="0, 5"/>
      <TextBox PlaceholderText="Type book name"
               Text="{Binding BookName}" />

      <Label Content="Book Author"
             Margin="0, 5"/>
      <TextBox PlaceholderText="Type book author"
               Text="{Binding Author}"/>

      <Label Content="Book Publisher"
             Margin="0, 5"/>
      <TextBox PlaceholderText="Type book publisher"
               Text="{Binding Publisher}" />

      <Label Content="Book ISBN"
             Margin="0, 5"/>
      <TextBox PlaceholderText="Type book ISBN"
               Text="{Binding Isbn}" />

      <Label Content="Book publication year"
             Margin="0, 5"/>
      <TextBox PlaceholderText="Type book publication year"
               Text="{Binding PublicationYear}" />

      <Label Content="Book genre"
             Margin="0, 5"/>
      <TextBox PlaceholderText="Type book genre"
               Text="{Binding Genre}" />

    </StackPanel>
      
    <StackPanel Grid.Row="2" 
      Orientation="Horizontal"
      Margin="10"
      Spacing="10">
      
  
        <Button 
              Content="Confirm" 
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Padding="10"
              Background="Green"
              Foreground="LightGreen"
              Click="Confirm_Click" />

        <Button 
              Content="Cancel"
                HorizontalAlignment="Center"
                Cursor="Hand"
                Padding="10"
                Background="DarkRed"
                Foreground="Red"
                Click="Close_Click" />

    </StackPanel>
  </Grid>
</Window>
